# VerifiableCoLearnerAgents (nopyjjyimtmvuucsirxb).
# Do not point these at a project in the Serenada organisation.
NUXT_PUBLIC_SUPABASE_URL=https://nopyjjyimtmvuucsirxb.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this with NUXT_PUBLIC_.
NUXT_SUPABASE_SECRET_KEY=

# Which model answers a turn when the product owner has not saved one.
#   real  an OpenAI-compatible API. DeepSeek is this client with the base URL below.
#   fake  the scripted Teacher and Deskmate, no network and no credential
# A blank value means real. A saved choice on /admin replaces these on the next
# turn, with no restart. Any other value is refused by name.
# A real model with a blank key, base URL, or model name stops the turn and
# names the field to fix.
NUXT_MODEL=real

# Server only. Never prefix NUXT_MODEL_API_KEY with NUXT_PUBLIC_.
NUXT_MODEL_API_KEY=
NUXT_MODEL_BASE_URL=https://api.deepseek.com
NUXT_MODEL_NAME=deepseek-flash

# Comma-separated emails that may open /admin. Anyone else is refused.
NUXT_ADMIN_EMAILS=owner@example.com

# Comma-separated emails that may open /lecturer. Course ownership is stored separately.
LECTURER_EMAILS=lecturer@example.com

# VerifyShield rules every teacher move unless this is off.
# off, false, or 0 switches it off for every student. Any other value, including
# a blank, leaves it on. A saved row in verify_shield_settings replaces this
# on the next turn, with no restart.
NUXT_VERIFYSHELD=on

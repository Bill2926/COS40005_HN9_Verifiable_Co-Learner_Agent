# VerifiableCoLearnerAgents (nopyjjyimtmvuucsirxb).
# Do not point these at a project in the Serenada organisation.
NUXT_PUBLIC_SUPABASE_URL=https://nopyjjyimtmvuucsirxb.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this with NUXT_PUBLIC_.
NUXT_SUPABASE_SECRET_KEY=

# Which model answers a turn. One of:
#   deepseek  the DeepSeek API, and the default when this is left empty
#   fake      the scripted Teacher and Deskmate, no network and no credential
#   ollama    a local model over Ollama
# Only the block belonging to the named provider is read; the others are
# ignored even when filled in. A blank setting the named provider needs stops
# the app and says which one to fix, so a typo cannot reach a student as a
# placeholder reply. Any other value here is refused by name.
NUXT_MODEL=deepseek

# Read only when NUXT_MODEL is deepseek.
# Server only. Never prefix NUXT_DEEPSEEK_API_KEY with NUXT_PUBLIC_.
NUXT_DEEPSEEK_API_KEY=
NUXT_DEEPSEEK_MODEL=deepseek-flash

# Read only when NUXT_MODEL is ollama.
# Write the bare host: the /v1 path is added and a trailing slash is dropped.
# The named model must be pulled locally before the first turn succeeds.
NUXT_OLLAMA_BASE_URL=http://localhost:11434
NUXT_OLLAMA_MODEL=llama3.1
